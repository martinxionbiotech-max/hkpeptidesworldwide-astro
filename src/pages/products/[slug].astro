---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, description, category, price, image, tags, jsonLd } = entry.data;

// Try to find a matching image in public/images/
let imageSrc = image ? `/images/${image}` : null;

// Canonical page URL (uses site from astro.config.mjs)
const siteUrl = Astro.site ? String(Astro.site).replace(/\/$/, '') : 'https://hkpeptidesworldwide.com';
const pageUrl = `${siteUrl}${Astro.url.pathname}`;

// --- Build Product schema (from frontmatter jsonLd.product, completed with url/image/category) ---
const baseProduct = (jsonLd && jsonLd.product) || {};
// Offers: Google requires Product markup to carry "offers", "review" or
// "aggregateRating" — a bare Product node raises
// "Either offers, review, or aggregateRating should be specified".
// The frontmatter already carries an inquiry-type Offer (no price: product pages
// show no price, so no price/priceCurrency may be emitted); we complete it with
// the page URL and the seller and carry over any rating/review data present.
const baseOffer = (baseProduct.offers && typeof baseProduct.offers === 'object') ? baseProduct.offers : {};
const offersSchema = {
  '@type': 'Offer',
  url: pageUrl,
  availability: baseOffer.availability || 'https://schema.org/InStock',
  itemCondition: baseOffer.itemCondition || 'https://schema.org/NewCondition',
  businessFunction: baseOffer.businessFunction || 'https://schema.org/Sell',
  seller: baseOffer.seller || { '@type': 'Organization', name: 'HKPEPTIDE WORLDWIDE', url: siteUrl },
  ...(baseOffer.eligibleRegion ? { eligibleRegion: baseOffer.eligibleRegion } : {}),
  ...(baseOffer.price ? { price: baseOffer.price, priceCurrency: baseOffer.priceCurrency || 'USD' } : {}),
};

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: baseProduct.name || title,
  description: baseProduct.description || description || undefined,
  ...(baseProduct.sku ? { sku: baseProduct.sku } : {}),
  brand: baseProduct.brand || { '@type': 'Brand', name: 'HKPEPTIDE WORLDWIDE' },
  ...(imageSrc ? { image: `${siteUrl}${imageSrc}` } : {}),
  ...(category ? { category } : {}),
  url: pageUrl,
  offers: offersSchema,
  ...(baseProduct.aggregateRating ? { aggregateRating: baseProduct.aggregateRating } : {}),
  ...(baseProduct.review ? { review: baseProduct.review } : {}),
};

// --- Build BreadcrumbList ---
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: 'Products', item: `${siteUrl}/products/` },
    { '@type': 'ListItem', position: 3, name: title, item: pageUrl },
  ],
};

// --- Extract FAQ from raw markdown body (Q/A blocks under "Frequently Asked Questions") ---
const faqItems: Array<{ '@type': string; name: string; acceptedAnswer: { '@type': string; text: string } }> = [];
if (entry.body && entry.body.includes('**Q:')) {
  const sections = entry.body.split('**Q:').slice(1);
  for (const section of sections) {
    const qEnd = section.indexOf('**');
    if (qEnd < 0) continue;
    const question = section.slice(0, qEnd).trim();
    const answerStart = section.indexOf('\n\n', qEnd);
    if (answerStart < 0) continue;
    let answer = section.slice(answerStart).trim();
    const nextQ = answer.indexOf('**Q:');
    const nextHeading = answer.indexOf('\n\n## ');
    let cut = answer.length;
    if (nextQ >= 0) cut = Math.min(cut, nextQ);
    if (nextHeading >= 0) cut = Math.min(cut, nextHeading);
    answer = answer.slice(0, cut).trim();
    if (question && answer) {
      faqItems.push({
        '@type': 'Question',
        name: question,
        acceptedAnswer: { '@type': 'Answer', text: answer },
      });
    }
  }
}
const faqSchema = faqItems.length > 0
  ? { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqItems }
  : null;
---

<Layout title={title} description={description || `${title} — HK Peptides Worldwide`}>
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

  <article class="mx-auto max-w-4xl px-4 py-8 sm:px-6 lg:px-8">
    <!-- Breadcrumb -->
    <nav class="mb-6 text-sm text-gray-500">
      <a href="/" class="hover:text-blue-600">Home</a>
      <span class="mx-2">/</span>
      <a href="/products" class="hover:text-blue-600">Products</a>
      <span class="mx-2">/</span>
      <span class="text-gray-900">{title}</span>
    </nav>

    <!-- Product Header -->
    <div class="grid gap-8 lg:grid-cols-2">
      {imageSrc && (
        <div class="overflow-hidden rounded-lg bg-gray-100">
          <img
            src={imageSrc}
            alt={title}
            class="h-full w-full object-cover"
            loading="eager"
          />
        </div>
      )}

      <div>
        <h1 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
          {title}
        </h1>

        {category && (
          <span class="mt-2 inline-block rounded-full bg-blue-100 px-3 py-1 text-sm font-medium text-blue-800">
            {category}
          </span>
        )}

        {price && (
          <p class="mt-4 text-2xl font-bold text-blue-600">
            ${price.toFixed(2)}
          </p>
        )}

        {description && (
          <p class="mt-4 text-lg leading-relaxed text-gray-600">
            {description}
          </p>
        )}

        {tags && tags.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-2">
            {tags.map((tag) => (
              <span class="rounded-md bg-gray-100 px-2 py-1 text-xs font-medium text-gray-600">
                {tag}
              </span>
            ))}
          </div>
        )}
      </div>
    </div>

    <!-- Product Content -->
    <div class="prose prose-lg mt-12 max-w-none prose-headings:text-gray-900 prose-p:text-gray-700 prose-a:text-blue-600 prose-table:border-collapse prose-th:border prose-th:border-gray-300 prose-th:bg-gray-50 prose-th:px-4 prose-th:py-2 prose-td:border prose-td:border-gray-300 prose-td:px-4 prose-td:py-2">
      <Content />
    </div>
  </article>
</Layout>
