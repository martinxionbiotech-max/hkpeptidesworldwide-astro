---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const products = await getCollection('products');

const productsSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "name": "Products — HK Peptides Worldwide",
      "description": "Browse our catalog of research-grade peptides and compounds.",
      "url": "https://hkpeptidesworldwide.com/products/",
      "isPartOf": { "@id": "https://hkpeptidesworldwide.com/#website" },
      "mainEntity": {
        "@type": "ItemList",
        "numberOfItems": products.length,
        "itemListElement": products.slice(0, 20).map((p, i) => ({
          "@type": "ListItem",
          "position": i + 1,
          "item": { "@type": "Product", "name": p.data.title, "url": `https://hkpeptidesworldwide.com/products/${p.id}/` }
        }))
      }
    }
  ]
};
---
<Layout title="Products — HK Peptides Worldwide" description="Browse our catalog of research-grade peptides and compounds." schema={productsSchema}>
  <section class="bg-[#0a1628] py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Research Products</h1>
      <p class="mt-3 text-lg text-gray-400">Browse our full catalog of {products.length} research-grade peptides and compounds.</p>
    </div>
  </section>

  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {products.map(p => {
        const { title, description, category, price, image } = p.data;
        const imgSrc = image ? `/images/${image}` : null;
        return (
          <a href={`/products/${p.id}`} class="group overflow-hidden rounded-2xl border border-gray-100 bg-white shadow-sm transition-all hover:-translate-y-1 hover:shadow-xl">
            <div class="aspect-square overflow-hidden bg-gradient-to-br from-gray-50 to-gray-100">
              {imgSrc ? (
                <img src={imgSrc} alt={title} class="h-full w-full object-contain p-5 transition-transform duration-500 group-hover:scale-110" loading="lazy" />
              ) : (
                <div class="flex h-full w-full items-center justify-center text-4xl">🧪</div>
              )}
            </div>
            <div class="border-t border-gray-50 p-4">
              {category && <span class="text-[11px] font-semibold uppercase tracking-wider text-emerald-600">{category}</span>}
              <h3 class="mt-1 text-sm font-semibold text-gray-900 line-clamp-2 group-hover:text-emerald-600">{title}</h3>
              {description && <p class="mt-1 text-xs text-gray-500 line-clamp-2">{description}</p>}
              <div class="mt-3 flex items-center justify-between">
                {price && <span class="text-base font-bold text-emerald-600">${price.toFixed(2)}</span>}
                <span class="text-xs font-medium text-gray-400 group-hover:text-emerald-600">Details →</span>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</Layout>
