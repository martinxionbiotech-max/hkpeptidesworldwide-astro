---
import { getCollection } from 'astro:content';
import Layout from "../../layouts/Layout.astro";

const posts = await getCollection('blog');
const sortedPosts = posts.sort(
  (a, b) => (b.data.pubDate?.getTime() ?? 0) - (a.data.pubDate?.getTime() ?? 0)
);

function formatDate(date: Date | undefined): string {
  if (!date) return '';
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<Layout title="Blog — HK Peptides Worldwide" description="Research insights, guides, and industry updates from HK Peptides Worldwide.">
  <div class="mx-auto max-w-4xl px-4 py-8 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="mb-10">
      <h1 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
        Blog
      </h1>
      <p class="mt-3 text-lg text-gray-600">
        Research insights, methodology guides, and industry updates.
      </p>
    </div>

    <!-- Blog List -->
    <div class="divide-y divide-gray-200">
      {sortedPosts.map((post) => {
        const { title, description, pubDate, author, tags } = post.data;

        return (
          <article class="py-6 first:pt-0 last:pb-0">
            <a
              href={`/blog/${post.id}`}
              class="group block"
            >
              <h2 class="text-xl font-semibold text-gray-900 group-hover:text-blue-600">
                {title}
              </h2>

              <div class="mt-2 flex items-center gap-3 text-sm text-gray-500">
                {pubDate && (
                  <time datetime={pubDate.toISOString()}>
                    {formatDate(pubDate)}
                  </time>
                )}
                {author && (
                  <>
                    <span aria-hidden="true">·</span>
                    <span>{author}</span>
                  </>
                )}
              </div>

              {description && (
                <p class="mt-2 text-gray-600 line-clamp-3">
                  {description}
                </p>
              )}

              {tags && tags.length > 0 && (
                <div class="mt-3 flex flex-wrap gap-2">
                  {tags.map((tag) => (
                    <span class="rounded-md bg-gray-100 px-2 py-1 text-xs font-medium text-gray-600">
                      {tag}
                    </span>
                  ))}
                </div>
              )}
            </a>
          </article>
        );
      })}
    </div>
  </div>
</Layout>
