---
import { getCollection } from 'astro:content';
import Layout from "../../layouts/Layout.astro";

const posts = await getCollection('blog');
const sortedPosts = posts.sort(
  (a, b) => (b.data.pubDate?.getTime() ?? 0) - (a.data.pubDate?.getTime() ?? 0)
);

function formatDate(date?: Date) {
  if (!date) return '';
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}

const blogSchema = {
  "@context": "https://schema.org",
  "@graph": [{
    "@type": "CollectionPage",
    "@id": "https://hkpeptides.net/blog/#blog",
    "name": "HK Peptides Research Blog",
    "description": "Research insights, methodology guides, and industry updates — covering HK peptides, peptide science, and laboratory best practices.",
    "url": "https://hkpeptides.net/blog/",
    "isPartOf": { "@id": "https://hkpeptides.net/#website" }
  }]
};
---
<Layout title="HK Peptides Research Blog — Insights & Guides" description="Research insights, methodology guides, and industry updates — covering HK peptides, peptide science, and laboratory best practices." schema={blogSchema}>
  <section class="bg-[#0a1628] py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Research Blog</h1>
      <p class="mt-3 text-lg text-gray-400">Research insights, methodology guides, and industry updates.</p>
    </div>
  </section>

  <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="divide-y divide-gray-100">
      {sortedPosts.map(post => {
        const { title, description, pubDate, author, tags } = post.data;
        return (
          <article class="py-8 first:pt-0 last:pb-0">
            <a href={`/blog/${post.id}`} class="group block">
              <div class="flex items-center gap-3 text-xs text-gray-400">
                {author && <span class="font-medium text-gray-500">{author}</span>}
                {pubDate && <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>}
              </div>
              <h2 class="mt-2 text-xl font-semibold text-gray-900 transition-colors group-hover:text-emerald-600">{title}</h2>
              {description && <p class="mt-2 text-gray-500 line-clamp-3">{description}</p>}
              {tags && tags.length > 0 && (
                <div class="mt-3 flex flex-wrap gap-2">
                  {tags.map(tag => <span class="rounded-lg bg-gray-100 px-2 py-1 text-xs font-medium text-gray-500">{tag}</span>)}
                </div>
              )}
            </a>
          </article>
        );
      })}
    </div>
  </div>
</Layout>
