---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const products = await getCollection('products');
const posts = await getCollection('blog');
const pillars = await getCollection('pillars');

// Sort pillars by order
const sortedPillars = pillars.sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)
);

// Latest 6 blog posts
const latestPosts = posts
  .sort((a, b) => (b.data.pubDate?.getTime() ?? 0) - (a.data.pubDate?.getTime() ?? 0))
  .slice(0, 6);

// 6 featured products
const featuredProducts = products.slice(0, 6);

function formatDate(date: Date | undefined): string {
  if (!date) return '';
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
}
---

<Layout
  title="HK Peptides Worldwide — Premium Research Peptides"
  description="High-purity research peptides and compounds for laboratory and scientific research. HPLC-verified, COA-tested, worldwide shipping."
>
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-blue-600 to-blue-800 text-white">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-32">
      <div class="max-w-3xl">
        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl">
          Premium Research Peptides
        </h1>
        <p class="mt-6 text-xl text-blue-100">
          High-purity, HPLC-verified peptides for laboratory and scientific
          research. COA-tested, worldwide shipping, trusted by researchers
          globally.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a
            href="/products"
            class="inline-flex items-center rounded-lg bg-white px-6 py-3 text-base font-semibold text-blue-700 shadow-sm hover:bg-blue-50 transition-colors"
          >
            Browse Products
          </a>
          <a
            href="/blog"
            class="inline-flex items-center rounded-lg border border-blue-300 px-6 py-3 text-base font-semibold text-white hover:bg-blue-700 transition-colors"
          >
            Research Blog
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Pillars -->
  <section class="bg-gray-50 py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
          Research Pillars
        </h2>
        <p class="mt-3 text-lg text-gray-600">
          Comprehensive guides and methodologies for peptide research.
        </p>
      </div>

      <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {sortedPillars.map((pillar) => {
          const { title, description } = pillar.data;
          return (
            <a
              href={`/pillars/${pillar.id}`}
              class="group rounded-xl border border-gray-200 bg-white p-6 shadow-sm transition-shadow hover:shadow-md"
            >
              <h3 class="text-lg font-semibold text-gray-900 group-hover:text-blue-600">
                {title}
              </h3>
              {description && (
                <p class="mt-2 text-sm text-gray-600 line-clamp-3">
                  {description}
                </p>
              )}
              <span class="mt-4 inline-flex items-center text-sm font-medium text-blue-600 group-hover:text-blue-800">
                Learn more
                <svg class="ml-1 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Latest Blog Posts -->
  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
            Latest Research
          </h2>
          <p class="mt-3 text-lg text-gray-600">
            Insights, guides, and industry updates.
          </p>
        </div>
        <a
          href="/blog"
          class="hidden text-sm font-semibold text-blue-600 hover:text-blue-800 sm:inline-flex sm:items-center sm:gap-1"
        >
          View all posts
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {latestPosts.map((post) => {
          const { title, description, pubDate, author } = post.data;
          return (
            <a
              href={`/blog/${post.id}`}
              class="group rounded-lg border border-gray-200 bg-white p-6 shadow-sm transition-shadow hover:shadow-md"
            >
              <h3 class="text-lg font-semibold text-gray-900 group-hover:text-blue-600 line-clamp-2">
                {title}
              </h3>
              <div class="mt-2 flex items-center gap-2 text-xs text-gray-500">
                {pubDate && <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>}
                {author && (
                  <>
                    <span>·</span>
                    <span>{author}</span>
                  </>
                )}
              </div>
              {description && (
                <p class="mt-3 text-sm text-gray-600 line-clamp-3">
                  {description}
                </p>
              )}
              <span class="mt-4 inline-flex items-center text-sm font-medium text-blue-600 group-hover:text-blue-800">
                Read article
                <svg class="ml-1 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </span>
            </a>
          );
        })}
      </div>

      <!-- Mobile view all link -->
      <div class="mt-8 text-center sm:hidden">
        <a
          href="/blog"
          class="inline-flex items-center text-sm font-semibold text-blue-600 hover:text-blue-800"
        >
          View all posts
          <svg class="ml-1 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Featured Products -->
  <section class="bg-gray-50 py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
            Featured Products
          </h2>
          <p class="mt-3 text-lg text-gray-600">
            High-purity research peptides trusted by laboratories worldwide.
          </p>
        </div>
        <a
          href="/products"
          class="hidden text-sm font-semibold text-blue-600 hover:text-blue-800 sm:inline-flex sm:items-center sm:gap-1"
        >
          View all products
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {featuredProducts.map((product) => {
          const { title, description, category, price, image } = product.data;
          const imageSrc = image ? `/images/${image}` : null;

          return (
            <a
              href={`/products/${product.id}`}
              class="group overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm transition-shadow hover:shadow-md"
            >
              <div class="aspect-video overflow-hidden bg-gray-100">
                {imageSrc ? (
                  <img
                    src={imageSrc}
                    alt={title}
                    class="h-full w-full object-cover transition-transform group-hover:scale-105"
                    loading="lazy"
                  />
                ) : (
                  <div class="flex h-full w-full items-center justify-center bg-blue-50">
                    <span class="text-5xl text-blue-300">🧪</span>
                  </div>
                )}
              </div>
              <div class="p-4">
                {category && (
                  <span class="text-xs font-medium uppercase tracking-wide text-blue-600">
                    {category}
                  </span>
                )}
                <h3 class="mt-1 text-base font-semibold text-gray-900 line-clamp-2 group-hover:text-blue-600">
                  {title}
                </h3>
                {description && (
                  <p class="mt-1 text-sm text-gray-500 line-clamp-2">
                    {description}
                  </p>
                )}
                {price && (
                  <p class="mt-2 text-lg font-bold text-blue-600">
                    ${price.toFixed(2)}
                  </p>
                )}
              </div>
            </a>
          );
        })}
      </div>

      <!-- Mobile view all link -->
      <div class="mt-8 text-center sm:hidden">
        <a
          href="/products"
          class="inline-flex items-center text-sm font-semibold text-blue-600 hover:text-blue-800"
        >
          View all products
          <svg class="ml-1 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </section>
</Layout>
