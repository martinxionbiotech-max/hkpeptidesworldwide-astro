---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import RuoNotice from '../components/RuoNotice.astro';

const products = await getCollection('products');
const posts = await getCollection('blog');
const pillars = await getCollection('pillars');

const siteSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://hkpeptides.net/#organization",
      "name": "HK Peptides Worldwide",
      "legalName": "HK Peptides Worldwide LLC",
      "url": "https://hkpeptides.net",
      "email": "aaronwong2023@gmail.com",
      "foundingDate": "2025",
      "description": "Premium research peptides supplier — HPLC-verified, COA-tested, worldwide shipping.",
      "sameAs": ["https://hkpeptides.net"]
    },
    {
      "@type": "WebSite",
      "@id": "https://hkpeptides.net/#website",
      "url": "https://hkpeptides.net",
      "name": "HK Peptides Worldwide",
      "publisher": { "@id": "https://hkpeptides.net/#organization" }
    }
  ]
};

const sortedPillars = pillars.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
const latestPosts = posts
  .sort((a, b) => (b.data.pubDate?.getTime() ?? 0) - (a.data.pubDate?.getTime() ?? 0))
  .slice(0, 3);
const featuredProducts = products.filter(p => {
  const slug = p.id;
  return slug.includes('bpc-157') || slug.includes('semaglutide') || slug.includes('tirzepatide') || slug.includes('retatrutide') || slug.includes('tb-500') || slug.includes('ghk-cu');
}).slice(0, 6);

function formatDate(date?: Date) {
  if (!date) return '';
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}
---
<Layout
  title="HK Peptides Worldwide — Premium Research Peptides"
  description="High-purity HK peptides for laboratory and scientific research. Premium research peptides — HPLC-verified, COA-tested, worldwide shipping."
  schema={siteSchema}
  ogImage="/images/default-og.jpg"
>
<RuoNotice />
  <!-- Hero -->
  <section class="relative overflow-hidden bg-[#0a1628]">
    <div class="absolute inset-0 bg-gradient-to-br from-emerald-500/5 via-transparent to-teal-500/5"></div>
    <div class="absolute right-0 top-0 -mr-20 -mt-20 h-[600px] w-[600px] rounded-full bg-gradient-to-br from-emerald-500/10 to-teal-500/5 blur-3xl"></div>
    <div class="relative mx-auto max-w-7xl px-4 py-24 sm:px-6 sm:py-32 lg:px-8 lg:py-40">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 rounded-full border border-emerald-500/20 bg-emerald-500/10 px-4 py-1.5 text-sm font-medium text-emerald-300">
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
          </span>
          HPLC-Verified & COA-Tested
        </div>
        <h1 class="mt-6 text-4xl font-bold tracking-tight text-white sm:text-5xl lg:text-6xl">
          Premium HK Peptides
          <span class="block bg-gradient-to-r from-emerald-300 to-teal-300 bg-clip-text text-transparent">for Research & Discovery</span>
        </h1>
        <p class="mt-6 text-lg leading-relaxed text-gray-300 sm:text-xl">
          High-purity HK peptides for laboratory and scientific research — HPLC-verified, COA-tested, worldwide shipping.
          Trusted by researchers globally for consistent quality and reliable delivery.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href="/products" class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-500 px-6 py-3.5 text-base font-semibold text-white shadow-lg shadow-emerald-500/25 transition-all hover:from-emerald-600 hover:to-teal-600 hover:shadow-xl hover:shadow-emerald-500/30">
            Browse Products
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
          </a>
          <a href="/blog" class="inline-flex items-center gap-2 rounded-xl border border-white/20 px-6 py-3.5 text-base font-semibold text-white transition-all hover:border-white/40 hover:bg-white/5">
            Research Blog
          </a>
        </div>
        <!-- Trust bar -->
        <div class="mt-12 flex flex-wrap gap-6 text-sm text-gray-400 sm:gap-10">
          <div class="flex items-center gap-2"><span class="text-emerald-400 font-semibold">99%+</span> HPLC Purity</div>
          <div class="flex items-center gap-2"><span class="text-emerald-400 font-semibold">100+</span> Products</div>
          <div class="flex items-center gap-2"><span class="text-emerald-400 font-semibold">🏭</span> Manufacturer Direct</div>
          <div class="flex items-center gap-2"><span class="text-emerald-400 font-semibold">🌍</span> Worldwide Shipping</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Products -->
  <section class="py-20 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between">
        <div>
          <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">Featured HK Peptides</h2>
          <p class="mt-3 text-lg text-gray-500">Research-grade HK peptides trusted by laboratories worldwide.</p>
        </div>
        <a href="/products" class="hidden items-center gap-1 text-sm font-semibold text-emerald-600 transition-colors hover:text-emerald-700 sm:inline-flex">
          View all <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {featuredProducts.map(p => {
          const { title, description, category, price, image } = p.data;
          const imgSrc = image ? `/images/${image}` : null;
          return (
            <a href={`/products/${p.id}`} class="group overflow-hidden rounded-2xl border border-gray-100 bg-white shadow-sm transition-all hover:-translate-y-1 hover:shadow-xl">
              <div class="aspect-[4/3] overflow-hidden bg-gradient-to-br from-gray-50 to-gray-100">
                {imgSrc ? (
                  <img src={imgSrc} alt={title} class="h-full w-full object-contain p-6 transition-transform duration-500 group-hover:scale-110" loading="lazy" />
                ) : (
                  <div class="flex h-full w-full items-center justify-center text-5xl">🧪</div>
                )}
              </div>
              <div class="border-t border-gray-50 p-5">
                {category && <span class="text-[11px] font-semibold uppercase tracking-wider text-emerald-600">{category}</span>}
                <h3 class="mt-1.5 font-semibold text-gray-900 line-clamp-2 group-hover:text-emerald-600">{title}</h3>
                {description && <p class="mt-1 text-sm text-gray-500 line-clamp-2">{description}</p>}
                <div class="mt-3 flex items-center justify-between">
                  {price && <span class="text-lg font-bold text-emerald-600">${price.toFixed(2)}</span>}
                  <span class="inline-flex items-center text-[13px] font-semibold text-gray-400 group-hover:text-emerald-600">
                    Details <svg class="ml-0.5 h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                  </span>
                </div>
              </div>
            </a>
          );
        })}
      </div>
      <div class="mt-8 text-center sm:hidden">
        <a href="/products" class="inline-flex items-center gap-1 rounded-lg bg-emerald-500 px-5 py-2.5 text-sm font-semibold text-white">View all products <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></a>
      </div>
    </div>
  </section>

  <!-- Pillars -->
  <section class="bg-gray-50 py-20 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">Research Pillars</h2>
        <p class="mt-3 text-lg text-gray-500">Comprehensive guides and methodologies for peptide research.</p>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {sortedPillars.map((pillar, i) => {
          const colors = [
            'from-emerald-500 to-teal-500',
            'from-blue-500 to-indigo-500',
            'from-violet-500 to-purple-500',
            'from-amber-500 to-orange-500'
          ];
          const icons = ['🔬', '🧬', '🛡️', '💊'];
          return (
            <a href={`/pillars/${pillar.id}`} class="group relative overflow-hidden rounded-2xl bg-white p-6 shadow-sm ring-1 ring-gray-100 transition-all hover:-translate-y-1 hover:shadow-lg">
              <div class={`mb-4 inline-flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br ${colors[i % 4]} text-lg`}>
                {icons[i % 4]}
              </div>
              <h3 class="text-base font-semibold text-gray-900">{pillar.data.title}</h3>
              {pillar.data.description && <p class="mt-2 text-sm text-gray-500 line-clamp-3">{pillar.data.description}</p>}
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Latest Blog -->
  <section class="py-20 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between">
        <div>
          <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">Latest Research</h2>
          <p class="mt-3 text-lg text-gray-500">Insights, guides, and industry updates.</p>
        </div>
        <a href="/blog" class="hidden items-center gap-1 text-sm font-semibold text-emerald-600 transition-colors hover:text-emerald-700 sm:inline-flex">
          View all <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {latestPosts.map(post => {
          const { title, description, pubDate, author } = post.data;
          return (
            <a href={`/blog/${post.id}`} class="group rounded-2xl border border-gray-100 bg-white p-6 shadow-sm transition-all hover:-translate-y-1 hover:shadow-lg">
              <div class="flex items-center gap-2 text-xs text-gray-400">
                {author && <span class="font-medium text-gray-500">{author}</span>}
                {pubDate && <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>}
              </div>
              <h3 class="mt-3 font-semibold text-gray-900 line-clamp-2 group-hover:text-emerald-600">{title}</h3>
              {description && <p class="mt-2 text-sm text-gray-500 line-clamp-3">{description}</p>}
              <span class="mt-4 inline-flex items-center text-sm font-medium text-emerald-600">Read more <svg class="ml-1 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></span>
            </a>
          );
        })}
      </div>
    </div>
  </section>
</Layout>
