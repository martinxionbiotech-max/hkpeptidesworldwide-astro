---
export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  schema?: Record<string, any>;
  type?: 'website' | 'article' | 'product';
  canonical?: string;
}

const {
  title,
  description = 'HK Peptides Worldwide — Premium HK peptides for scientific research. HPLC-verified, COA-tested, worldwide shipping from manufacturer direct.',
  ogImage = '/images/default-og.jpg',
  schema,
  type = 'website',
  canonical,
} = Astro.props;

const siteUrl = 'https://hkpeptides.net';
const pageUrl = canonical ? `${siteUrl}${canonical}` : new URL(Astro.url.pathname, siteUrl).href;
const brandTitle = title.includes('HK Peptides Worldwide') ? title : `${title} — HK Peptides Worldwide`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />

    <title>{brandTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={brandTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="HK Peptides Worldwide" />
    <meta property="og:locale" content="en_US" />
    {ogImage && <meta property="og:image" content={`${siteUrl}${ogImage}`} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={brandTitle} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />}

    <link rel="alternate" hreflang="en" href={pageUrl} />
    <link rel="alternate" hreflang="x-default" href={pageUrl} />

    <meta name="generator" content={Astro.generator} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body class="min-h-screen bg-white text-gray-900 antialiased">
    <header class="sticky top-0 z-50 border-b border-white/10 bg-[#0a1628]/95 backdrop-blur-xl supports-[backdrop-filter]:bg-[#0a1628]/80">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <nav class="flex h-16 items-center justify-between">
          <a href="/" class="flex items-center gap-2 text-lg font-bold text-white">
            <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-br from-emerald-400 to-teal-500 text-sm font-black text-white">HK</span>
            <span class="hidden sm:inline">Peptides Worldwide</span>
          </a>
          <ul class="flex items-center gap-1 text-sm font-medium">
            <li><a href="/" class="rounded-lg px-3 py-2 text-gray-300 transition-colors hover:bg-white/10 hover:text-white">Home</a></li>
            <li><a href="/products" class="rounded-lg px-3 py-2 text-gray-300 transition-colors hover:bg-white/10 hover:text-white">Products</a></li>
            <li><a href="/blog" class="rounded-lg px-3 py-2 text-gray-300 transition-colors hover:bg-white/10 hover:text-white">Blog</a></li>
            <li><a href="/about" class="rounded-lg px-3 py-2 text-gray-300 transition-colors hover:bg-white/10 hover:text-white">About</a></li>
            <li><a href="/contact" class="ml-2 rounded-lg bg-gradient-to-r from-emerald-500 to-teal-500 px-4 py-2 text-white transition-all hover:from-emerald-600 hover:to-teal-600 hover:shadow-lg hover:shadow-emerald-500/25">Contact</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="border-t border-gray-100 bg-[#0a1628] text-gray-300">
      <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
          <div>
            <a href="/" class="flex items-center gap-2 text-lg font-bold text-white">
              <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-br from-emerald-400 to-teal-500 text-sm font-black text-white">HK</span>
              HK Peptides Worldwide
            </a>
            <p class="mt-3 text-sm leading-relaxed text-gray-400">
              Premium HK peptides — HPLC-verified, COA-tested, manufacturer direct shipping worldwide. Trusted by researchers globally.
            </p>
          </div>
          <div>
            <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-200">Products</h3>
            <ul class="mt-4 space-y-2 text-sm">
              <li><a href="/products" class="text-gray-400 transition-colors hover:text-emerald-400">All Products</a></li>
              <li><a href="/blog" class="text-gray-400 transition-colors hover:text-emerald-400">Research Blog</a></li>
              <li><a href="/about" class="text-gray-400 transition-colors hover:text-emerald-400">About Us</a></li>
            </ul>
          </div>
          <div>
            <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-200">Support</h3>
            <ul class="mt-4 space-y-2 text-sm">
              <li><a href="/contact" class="text-gray-400 transition-colors hover:text-emerald-400">Contact Us</a></li>
              <li><a href="/how-to-buy" class="text-gray-400 transition-colors hover:text-emerald-400">How to Buy</a></li>
              <li><a href="/refund_returns" class="text-gray-400 transition-colors hover:text-emerald-400">Refund & Returns</a></li>
              <li><a href="/privacy-policy" class="text-gray-400 transition-colors hover:text-emerald-400">Privacy Policy</a></li>
            </ul>
          </div>
          <div>
            <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-200">Contact</h3>
            <ul class="mt-4 space-y-2 text-sm text-gray-400">
              <li>📍 New York, NY 10019</li>
              <li>📧 <a href="mailto:aaron@senobiocorp.com" class="text-gray-400 transition-colors hover:text-emerald-400">aaron@senobiocorp.com</a></li>
              <li>
                <a href="https://wa.me/64204310558" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 rounded-lg bg-green-600 px-3 py-1.5 text-white transition-all hover:bg-green-700 hover:shadow-lg hover:shadow-green-600/25">
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                  WhatsApp
                </a>
              </li>
              <li>🏭 Manufacturer Direct Ship</li>
            </ul>
          </div>
        </div>
        <div class="mt-10 border-t border-white/10 pt-6 text-center text-sm text-gray-500">
          &copy; {new Date().getFullYear()} HK Peptides Worldwide LLC. All rights reserved. HK peptides sold for laboratory research purposes only.
        </div>
      </div>
    </footer>
  </body>
</html>
